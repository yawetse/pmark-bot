# Safe local defaults. Copy to `.env` for local-only overrides.
APP_ENV=local
ENVIRONMENT=local
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=set-locally
AWS_PROFILE=
LIVE_ENABLED=false
TRADING_ACCOUNT_MODE=local
DEFAULT_SELECTED_VENUE=polymarket_us
POLYMARKET_US_ENABLED=false
POLYMARKET_INTERNATIONAL_ENABLED=false
ALPACA_ENABLED=false
POLYMARKET_MARKET_ORDER_SLIPPAGE=0.02
ALPACA_MARKET_ORDER_SLIPPAGE=0.005
ALPACA_ACCOUNT_STATUS=active
ALPACA_SYMBOL_PRESETS=sp500,nasdaq100
ALPACA_CUSTOM_SYMBOLS=
ALPACA_SYMBOL_UNIVERSE=
POLYMARKET_API_BASE_URL=https://api.polymarket.us
POLYMARKET_GATEWAY_BASE_URL=https://gateway.polymarket.us
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_MARKET_DATA_LIMIT=5
POLYMARKET_ORDER_BOOK_RETRIES=2
POLYMARKET_ORDER_BOOK_RETRY_BACKOFF_SECONDS=0.25
POLYMARKET_ORDER_BOOK_CONCURRENCY=4
POLYMARKET_ORDER_BOOK_CACHE_TTL_SECONDS=300
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codex_poly_bot
POSTGRES_USER=codex_poly_bot
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://codex_poly_bot:change-me@localhost:5432/codex_poly_bot
GITHUB_ALLOWED_USERS=
DASHBOARD_ALLOWED_USERS=yaw
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BACKEND_TOKEN_SIGNING_SECRET=set-locally
DASHBOARD_SESSION_SECRET=set-locally
DASHBOARD_CSRF_TOKEN=set-locally
NEXTAUTH_URL=http://localhost:3000
DASHBOARD_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local
ALLOW_LOCAL_AUTH_BYPASS=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
POLYMARKET_PRIVATE_KEY=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets/v2
ALPACA_DATA_FEED=iex
ALPACA_SYMBOL_CHUNK_SIZE=50
ALPACA_ENABLE_PER_SYMBOL_FALLBACK=true
ALPACA_PER_SYMBOL_FALLBACK_LIMIT=25
ALPACA_HISTORICAL_BAR_LIMIT=30
AWS_SECRET_ACCESS_KEY=
