# Copy to .env (gitignored). Local-only secrets and config overrides.
# Production values live in AWS Secrets Manager - never commit real values.

# Environment + safety defaults
CLAUDE_POLY_BOT_ENV=dev
LOCAL=1
DRY_RUN=true
LIVE_ENABLED=false

# Database (matches docker-compose default)
DATABASE_URL=postgresql+asyncpg://claude_poly_bot:dev_password@db:5432/claude_poly_bot

# AWS (optional locally; set if testing against real AWS)
AWS_REGION=us-east-1

# LLM API keys (placeholders - get real keys from console.anthropic.com / platform.openai.com)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Polygon RPC (Alchemy free tier works)
POLYGON_RPC_URL=

# Polymarket - per-bot wallet keys (populated by `claude-poly-bot setup-wallets`)
WALLET_CLAUDE_PRIVATE_KEY=
WALLET_OPENAI_PRIVATE_KEY=

# Alpaca - per-(bot, mode) keys (populated by `claude-poly-bot setup-alpaca`)
ALPACA_CLAUDE_PAPER_KEY_ID=
ALPACA_CLAUDE_PAPER_SECRET=
ALPACA_CLAUDE_LIVE_KEY_ID=
ALPACA_CLAUDE_LIVE_SECRET=
ALPACA_OPENAI_PAPER_KEY_ID=
ALPACA_OPENAI_PAPER_SECRET=
ALPACA_OPENAI_LIVE_KEY_ID=
ALPACA_OPENAI_LIVE_SECRET=

# OAuth (populated by `claude-poly-bot setup-oauth`)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# SMTP (local: MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SES_FROM_ADDRESS=noreply@local
SES_TO_ADDRESSES=yaw.etse@gmail.com
