# Multi-stage build for the Python bot/api/scanner/data-refresh services.
# The same image is used for all four; ENTRYPOINT discriminates by CMD args.

FROM python:3.12-slim AS builder
WORKDIR /build

# Install uv (fast Python package manager)
RUN pip install --no-cache-dir uv==0.5.4

# Copy dependency files
COPY python/pyproject.toml ./pyproject.toml

# Install runtime dependencies (no dev)
RUN uv pip install --system --no-cache .

FROM python:3.12-slim
WORKDIR /app

# Install only what we kept from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy source
COPY python/claude_poly_bot ./claude_poly_bot
COPY python/alembic.ini ./
COPY python/alembic ./alembic

# Non-root user
RUN groupadd -r bot && useradd -r -g bot -u 1000 bot && chown -R bot:bot /app
USER bot

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Default to scanner; override in ECS task def per service.
ENTRYPOINT ["python", "-m", "claude_poly_bot"]
CMD ["scanner"]
